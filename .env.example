# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys.
# .env.local is gitignored. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY: never prefix with NEXT_PUBLIC_,
# never import from a "use client" file. Leave empty unless a server action truly needs it.
SUPABASE_SECRET_KEY=
